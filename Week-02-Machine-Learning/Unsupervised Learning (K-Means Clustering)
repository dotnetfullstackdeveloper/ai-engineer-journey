import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans

Part:2

data = {
"Hours": [1,2,3,4,5,6,7,8],
"Marks": [40,42,50,54,70,78,90,95]
}
df = pd.DataFrame(data)

Part:3

plt.scatter(df["Hours"], df["Marks"])
plt.xlabel("Hours")
plt.ylabel("Marks")
plt.title("Student Data")
plt.show()

Part:4

plt.scatter(df["Hours"], df["Marks"])
plt.xlabel("Hours")
plt.ylabel("Marks")
plt.title("Student Data")
plt.show()

model = KMeans(
n_clusters=2,
random_state=42
)

Part:5

df["Cluster"] = model.fit_predict(
df[["Hours", "Marks"]]
)
print(df)

Part:6

plt.scatter(
df["Hours"],
df["Marks"],
c=df["Cluster"]
)
plt.xlabel("Hours")
plt.ylabel("Marks")
plt.title("K-Means Clustering")
plt.show()

